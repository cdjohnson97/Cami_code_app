# Variables du conteneur CaMI (docker compose). Copie ce fichier en .env.docker et remplis-le.
# Pas de guillemets autour des valeurs. Ce fichier n'entre jamais dans l'image (.dockerignore)
# et n'est pas versionné (.gitignore).

# MongoDB Atlas. La forme mongodb+srv:// fonctionne normalement dans le conteneur (Linux) ;
# la forme standard mongodb://hôte1,hôte2,hôte3/?... marche aussi.
MONGODB_URI=
MONGODB_DB=cami

# Clé secrète des sessions — génère-la avec : npx auth secret
# (garde la même entre deux déploiements, sinon tout le monde est déconnecté)
AUTH_SECRET=

# Google Cloud Console → Credentials → client OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
