# Copie ce fichier en .env.local et remplis TOUTES les valeurs ci-dessous.
# Sans ce fichier, CaMI fonctionne quand même très bien : juste en localStorage, sans compte
# ni tableau de bord admin. Voir le README (« Backend (optionnel) ») pour la marche à suivre.

# MongoDB Atlas → Database → Connect → Drivers → chaîne de connexion
MONGODB_URI=
# Nom de la base (optionnel, "cami" par défaut)
MONGODB_DB=cami

# Clé secrète qui signe les cookies de session — génère-la avec : npx auth secret
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type "Web application")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Inutile avec `npm run dev` et sur Vercel. OBLIGATOIRE avec `npm start` (même en local) et sur
# tout autre hébergeur (Netlify, VPS, Docker…), sinon la connexion échoue (erreur UntrustedHost).
# AUTH_TRUST_HOST=true
